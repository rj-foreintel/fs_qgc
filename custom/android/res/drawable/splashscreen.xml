<?xml version="1.0" encoding="UTF-8"?>
<!-- ForeView start-up screen (replaces android/res/drawable/splashscreen.xml): the app icon tile
     with "Powered by Foreintel" below, on black. foreview_splash.png is generated per density. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/foreview_splash" android:gravity="center"/>
    </item>
</layer-list>
